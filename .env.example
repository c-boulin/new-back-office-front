# ==========================================================================
# .env.example — Reference for ALL available VITE_* variables.
#
# You do NOT need to copy this file to .env for local development.
# Vite automatically loads .env.development (versioned) in dev mode.
# Only create a local .env if you need to override a specific value
# (e.g. point to a different backend). A local .env takes priority.
# ==========================================================================

# API — dating-backoffice-api
VITE_API_BASE_URL=https://876avtwsc1.execute-api.eu-west-1.amazonaws.com/dev/api

# Product identity injected in auth bodies and metier queries.
VITE_DEFAULT_PRODUCT_ID=69

# Authentication methods (at least one must be true)
VITE_AUTH_PASSWORD_ENABLED=true
VITE_AUTH_SSO_ENABLED=true

# Login (password + SSO) and back-office user/roles/permissions/product-config
# always hit VITE_API_BASE_URL; the rest of the app runs on mock seeds.
VITE_AUTH_REAL=true

# Mocks — ON everywhere except the always-real routes above.
VITE_MOCK_API=true
VITE_MOCK_PERSIST=false

# Feature flags
VITE_ENABLE_MSW=false
