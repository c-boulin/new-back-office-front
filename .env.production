# Production environment — loaded by Vite during `npm run build` (mode=production).
# Safety guard: ensures mocks are NEVER active in a production bundle.

# API — dating-backoffice-api (production URL, override in deployment CI)
VITE_API_BASE_URL=https://876avtwsc1.execute-api.eu-west-1.amazonaws.com/dev/api

# Product identity
VITE_DEFAULT_PRODUCT_ID=69

# Authentication methods
VITE_AUTH_PASSWORD_ENABLED=true
VITE_AUTH_SSO_ENABLED=true

# All routes hit the real backend in production.
VITE_AUTH_REAL=true

# Mocks — OFF in production. Never change these.
VITE_MOCK_API=false
VITE_MOCK_PERSIST=false

# Feature flags
VITE_ENABLE_MSW=false
